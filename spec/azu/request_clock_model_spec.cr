require "../spec_helper"

# A model-based check of `Azu::RequestClock`: Crystal's own `HTTP::Server::RequestProcessor` serves generated requests
# from a fake socket that drives the clock as `LimitedSocket` does, and at every read of the socket the phase the clock
# chose is compared with the phase the server is really in, known from where the read starts in the generated bytes.

MODEL_CLOCK_PHASES = {Azu::RequestClock::Phase::Headers => :headers, Azu::RequestClock::Phase::Body => :body,
                      Azu::RequestClock::Phase::Idle => :idle, Azu::RequestClock::Phase::Released => :released}

private record ModelRequest, headers_start : Int32, body_start : Int32, body_end : Int32

private class ModelSocket < IO
  include IO::Buffered

  # {truth, clock} at every read of the socket.
  getter phases = [] of {Symbol, Symbol}

  def initialize(@bytes : Bytes, @cuts : Array(Int32), @clock : Azu::RequestClock, @requests : Array(ModelRequest))
    @position = 0
  end

  def unbuffered_read(slice : Bytes) : Int32
    return 0 if @position >= @bytes.size
    @clock.before_read
    @phases << {truth, MODEL_CLOCK_PHASES[@clock.phase]}
    finish = @cuts.find { |cut| cut > @position } || @bytes.size
    count = Math.min(slice.size, finish - @position)
    slice.copy_from(@bytes[@position, count].to_unsafe, count)
    @position += count
    @clock.after_read(slice[0, count])
    count
  end

  def unbuffered_write(slice : Bytes) : Nil
    @clock.after_write(slice)
  end

  def unbuffered_flush : Nil
  end

  def unbuffered_close : Nil
  end

  def unbuffered_rewind : Nil
  end

  # Where the server is when it reads from `@position`: waiting for the first request's headers, for the next request,
  # in a request's headers, or in its body.
  private def truth : Symbol
    @requests.each_with_index do |request, index|
      return index == 0 ? :headers : :idle if @position == request.headers_start
      return :headers if request.headers_start < @position < request.body_start
      return :body if request.body_start <= @position < request.body_end
    end
    :idle
  end
end

private def model_chunked_body(random : Random, framed : Bool) : String
  eol = -> { random.rand(4) == 0 ? "\n" : "\r\n" }
  String.build do |io|
    random.rand(0..3).times do
      size = random.rand(1..20)
      digits = size.to_s(16)
      io << (random.rand(2) == 0 ? digits : digits.upcase) << (random.rand(4) == 0 ? ";ext=1" : "") << eol.call
      io << "c" * size << eol.call
    end
    io << "0" << eol.call
    io << (framed ? eol.call : "X-Trailer: t\r\n\r\n")
  end
end

# Serves *count* generated connections; {truth, clock} => how many reads.
private def model_run(seed : Int32, count : Int32, kinds : Array(Symbol)) : Hash({Symbol, Symbol}, Int32)
  random = Random.new(seed)
  stats = Hash({Symbol, Symbol}, Int32).new(0)
  count.times do
    text = IO::Memory.new
    requests = [] of ModelRequest
    total = random.rand(1..5)
    total.times do |index|
      kind = kinds.sample(random)
      mode = kind.in?(:length, :expect) ? {"read_then_write", "write_then_read", "write_chunks"}.sample(random) : "write_chunks"
      mode = {"read_then_write", "write_chunks"}.sample(random) if kind.in?(:chunked, :unknown_chunked)
      start = text.pos.to_i32
      body = ""
      case kind
      when :get    then text << "GET /#{mode} HTTP/1.1\r\nHost: x\r\n"
      when :head   then text << "HEAD /#{mode} HTTP/1.1\r\nHost: x\r\n"
      when :http10 then text << "GET /#{mode} HTTP/1.0\r\nConnection: keep-alive\r\n"
      when :length
        body = "b" * random.rand(0..40)
        text << "POST /#{mode} HTTP/1.1\r\nContent-Length: #{body.size}\r\n"
      when :expect
        body = "e" * random.rand(1..40)
        text << "POST /#{mode} HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: #{body.size}\r\n"
      else
        body = model_chunked_body(random, kind == :chunked)
        text << "POST /#{mode} HTTP/1.1\r\nTransfer-Encoding: chunked\r\n"
      end
      text << "Connection: close\r\n" if index == total - 1 && random.rand(2) == 0
      text << "\r\n"
      body_start = text.pos.to_i32
      text << body
      requests << ModelRequest.new(start, body_start, text.pos.to_i32)
    end
    bytes = text.to_slice
    cuts = Array.new(random.rand(0..6)) { random.rand(1...bytes.size) }
    requests.each do |request| # and sometimes exactly where headers or a body end
      cuts << request.body_start if random.rand(4) == 0
      cuts << request.body_end if random.rand(4) == 0
    end

    limits = Azu::ServerLimitsConfiguration.new
    limits.min_body_rate = 0
    clock = Azu::RequestClock.new(limits)
    socket = ModelSocket.new(bytes, cuts.uniq.sort!, clock, requests)
    processor = HTTP::Server::RequestProcessor.new do |context|
      body = context.request.body
      case context.request.path
      when "/read_then_write"
        body.try &.gets_to_end
        context.response << "ok"
      when "/write_then_read"
        context.response << "early"
        context.response.flush
        body.try &.gets_to_end
        context.response << "late"
      else
        body.try &.gets_to_end
        3.times { context.response << "piece"; context.response.flush }
      end
    end
    processor.process(socket)
    socket.phases.each { |phase| stats[phase] += 1 }
  end
  stats
end

describe Azu::RequestClock do
  it "is in the phase the server is in at every read of the socket, chunked bodies included (model-based)" do
    stats = model_run(20261028, 3000, [:get, :head, :length, :chunked, :expect, :http10])
    mismatches = stats.reject { |(truth, clock), _| truth == clock }
    mismatches.should be_empty
    stats.select { |(truth, _), _| truth == :body }.values.sum.should be > 500
  end

  it "keeps the residual of chunked bodies of unknown length (trailers) where it is documented" do
    # A body whose end the stream cannot read is taken to end where its request is answered, or, when several requests
    # are owed at a read, to be the one still read (`RequestClock#catch_up`; docs/reference/configuration/options.md).
    # With such bodies among the requests, the clock is then sometimes in another phase than the server; these are the
    # counts for this seed (Crystal 1.22.1), kept as an upper bound: {truth, clock} => reads.
    residual = { {:headers, :body} => 79, {:idle, :body} => 51, {:body, :headers} => 79, {:body, :idle} => 187,
                {:headers, :idle} => 393, {:idle, :headers} => 30 }
    stats = model_run(7, 3000, [:get, :length, :chunked, :unknown_chunked, :expect])
    stats.each do |(truth, clock), count|
      next if truth == clock
      count.should be <= residual.fetch({truth, clock}, 0)
    end
  end
end
