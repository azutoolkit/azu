/lib/
/bin/
/.shards/
.vscode/
*.dwarf
*.log

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock

# Shards installed for the playground app
/playground/lib/
playground/bin/

# SQLite file the CQL demo recreates on every start
/playground/azu_cql_demo.db

# Spark benchmark: the built server binary and the result files
/benchmark/spark/bin/
/benchmark/spark/results/

# Framework benchmark suite: built apps, installed shards, the seeded database and the result files
/benchmark/apps/*/bin/
/benchmark/apps/*/lib/
/benchmark/db/*.sqlite3*
/benchmark/results/
