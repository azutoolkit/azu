# Opt-in bridge between the CQL ORM and Azu's dev dashboard.
#
#   # src/initializers/cql_config.cr
#   require "pg"
#   require "azu/cql"
#
#   Azu::CQL.configure do |c|            # CQL's own configuration
#     c.db = ENV["DATABASE_URL"]
#     c.pool.size = 10
#   end
#
#   AppDB = Azu::CQL.schema :app do      # URL, adapter and pool come from CQL.config
#     table :users { primary :id, Int64; column :name, String }
#   end
#
# Every query, transaction and the connection pool then show up in the dashboard's
# "Database & Queries" tab, tagged with the HTTP request that ran them. Models, queries
# and migrations are plain CQL. For a schema defined elsewhere (a generated `src/db/schema.cr`)
# use `Azu::CQL.attach { AppDB }` in the initializer.
require "cql"
require "../query_store"
require "../request_context"
require "./instrumentor"
require "./adapter"
require "./mapping"
require "./validation"
require "./middleware"

# The dashboard is fed through CQL's event framework, which gained transaction events and pool
# stats after 0.0.533: fail with one clear message instead of a cascade of missing methods.
{% unless ::CQL.has_constant?("Telemetry") && ::CQL::Telemetry.class.has_method?("subscribe_transactions") && ::CQL::Schema.has_method?("pool_stats") %}
  {% raise "azu/cql needs a CQL release that provides CQL::Telemetry.subscribe_transactions and CQL::Schema#pool_stats (newer than 0.0.533). Update the cql shard." %}
{% end %}

module Azu
  module CQL
    # Raised by `verify!` when the database cannot be reached.
    class VerificationError < Exception
    end

    # CQL's own configuration (`CQL.configure`), plus the dashboard instrumentation, which is
    # installed right away so `cql.connect` and early queries are captured. Apps that
    # `include Azu` see this module as `CQL`, so `CQL.configure` there resolves to this method.
    def self.configure(& : ::CQL::Configure::Config ->) : ::CQL::Configure::Config
      Instrumentor.install
      ::CQL.configure { |config| yield config }
    end

    def self.config : ::CQL::Configure::Config
      ::CQL.config
    end

    def self.reset_config! : Nil
      ::CQL.reset_config!
    end

    # Defines a schema and wires instrumentation and the playground to it.
    #
    # The URL is, in order: the `uri` argument, `CQL.config.db` once it has been set,
    # `Azu::CONFIG.database.uri` (deprecated, defaults to `DATABASE_URL`). The adapter is picked from
    # the URL scheme. The connection is lazy by default (`database.lazy_connect`, or `lazy:`): the
    # schema is created without opening a socket and the first query connects.
    def self.schema(name : Symbol = :app, uri : String? = nil, lazy : Bool? = nil, &) : ::CQL::Schema
      base, from_config = resolve_uri(uri)
      resolved = connection_url(base, ::CQL.config, lazy.nil? ? Azu::CONFIG.database.lazy_connect? : lazy, pool: from_config)
      Instrumentor.install
      schema = ::CQL::Schema.new(name, resolved, adapter_for(resolved))
      with schema yield
      attach(schema)
    end

    # Wires instrumentation and the dashboard playground to an existing schema.
    def self.attach(schema : ::CQL::Schema) : ::CQL::Schema
      Instrumentor.install
      QueryStore.instance.adapter = SchemaAdapter.new(schema)
      schema
    end

    # Same, for a schema that does not exist yet (initializers load before `db/schema.cr`, and the
    # file may be regenerated by CQL's schema dump): the block runs the first time the dashboard
    # needs the schema.
    #
    #   Azu::CQL.attach { AppDB }
    def self.attach(&block : -> ::CQL::Schema) : Nil
      Instrumentor.install
      QueryStore.instance.adapter = SchemaAdapter.new(block)
    end

    # Fails fast (for example at boot in production) when the database is unreachable.
    def self.verify!(schema : ::CQL::Schema) : ::CQL::Schema
      schema.with_connection { |connection| connection.scalar("SELECT 1") }
      schema
    rescue ex
      raise VerificationError.new(<<-MSG)
        Cannot reach the database (#{redact(schema.uri)}): #{ex.message.presence || ex.class.name}
          - Is the server running and reachable?
          - Set the URL with CQL.configure { |c| c.db = ENV["DATABASE_URL"] }.
        MSG
    end

    # Runs the block in a database transaction (rolled back on exception); the
    # queries inside are visible as one transaction in the dashboard.
    def self.transaction(schema : ::CQL::Schema, &)
      schema.transaction { |_tx| yield }
    end

    def self.adapter_for(uri : String) : ::CQL::Adapter
      case scheme = URI.parse(uri).scheme
      when "postgres", "postgresql" then ::CQL::Adapter::Postgres
      when "cockroachdb"            then ::CQL::Adapter::CockroachDB
      when "mysql"                  then ::CQL::Adapter::MySql
      when "sqlite3"                then ::CQL::Adapter::SQLite
      else
        raise ArgumentError.new("Unsupported database URL scheme #{scheme.inspect}; use postgres://, cockroachdb://, mysql:// or sqlite3://")
      end
    end

    # The URL handed to CQL: `base` unchanged, plus the crystal-db pool parameters it does not
    # already set (`initial_pool_size=0` when lazy; the pool size, idle size and checkout
    # timeout of `config.pool`, and for SQLite its `config.sqlite` pragmas (journal_mode, foreign_keys,
    # busy_timeout, ...), when `pool` is true). Parameters already on the URL always win and nothing
    # before the `?` is touched. Deliberately not `config.full_db_url`, which also injects SSL,
    # authentication and retry settings.
    def self.connection_url(base : String, config : ::CQL::Configure::Config = ::CQL.config, lazy : Bool = true, pool : Bool = false) : String
      location, _, query = base.partition('?')
      params = HTTP::Params.parse(query)
      wanted = {} of String => String
      if pool
        wanted["max_pool_size"] = config.pool.size.to_s
        wanted["max_idle_pool_size"] = config.pool.max_idle_size.to_s
        wanted["checkout_timeout"] = config.pool.checkout_timeout.total_seconds.to_s
        sqlite_pragmas(base, config).each { |key, value| wanted[key] = value }
      end
      if lazy
        wanted["initial_pool_size"] = "0"
      elsif pool
        wanted["initial_pool_size"] = config.pool.initial_size.to_s
      end
      wanted.reject! { |key, _| params.has_key?(key) }
      return base if wanted.empty?
      wanted.each { |key, value| params[key] = value }
      "#{location}?#{params}"
    end

    # CQL's SQLite defaults (WAL, foreign keys on, a busy timeout) as URL parameters. crystal-sqlite3
    # applies them on every pooled connection; without them a bare `sqlite3://` URL runs with foreign
    # keys off and no busy timeout.
    private def self.sqlite_pragmas(url : String, config : ::CQL::Configure::Config) : Hash(String, String)
      params = HTTP::Params.new
      config.sqlite.apply_to_params(params) if url.starts_with?("sqlite3:")
      pragmas = {} of String => String
      params.each { |key, value| pragmas[key] = value }
      pragmas
    end

    # {URL, whether it came from CQL.config}
    private def self.resolve_uri(uri : String?) : {String, Bool}
      return {uri, false} if uri
      configured = ::CQL.config.db
      return {configured, true} unless configured == ::CQL::Configure::Config.new.db
      if fallback = Azu::CONFIG.database.uri.presence
        return {fallback, false}
      end
      raise ArgumentError.new("Azu::CQL.schema needs a database URL: CQL.configure { |c| c.db = ENV[\"DATABASE_URL\"] } (or pass a uri)")
    end

    private def self.redact(url : String) : String
      url.sub(%r{(://[^:/@]*:)[^@]*@}, "\\1***@")
    end

    # Apps usually `include Azu`, which makes this module visible as `CQL` inside
    # their namespace, and CQL's own macros expand unqualified `CQL::...` there.
    # Mirror every ORM type here so `CQL::ActiveRecord::Model` keeps resolving.
    {% for name in ::CQL.constants %}
      {% type = ::CQL.constant(name) %}
      {% if type.is_a?(TypeNode) && !Azu::CQL.has_constant?(name) %}
        alias {{ name.id }} = ::CQL::{{ name.id }}
      {% end %}
    {% end %}
  end
end
