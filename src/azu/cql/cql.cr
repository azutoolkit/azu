# Opt-in bridge between the CQL ORM and Azu's dev dashboard.
#
#   # src/initializers/cql_config.cr
#   require "azu/cql"                   # PostgreSQL needs no driver shard: CQL's native engine serves it
#                                       # (require "sqlite3" or "mysql" for those databases)
#
#   Azu::CQL.configure do |c|            # CQL's own configuration
#     c.db = ENV["DATABASE_URL"]
#     c.pool.size = 10
#   end
#
#   AppDB = Azu::CQL.schema :app do      # URL, adapter and pool come from CQL.config
#     table :users { primary :id, Int64; column :name, String }
#   end
#
# Every query, transaction and the connection pool then show up in the dashboard's
# "Database & Queries" tab, tagged with the HTTP request that ran them. Models, queries
# and migrations are plain CQL. For a schema defined elsewhere (a generated `src/db/schema.cr`)
# use `Azu::CQL.attach { AppDB }` in the initializer.
require "cql"
require "../query_store"
require "../request_context"
require "./instrumentor"
require "./adapter"
require "./driver"
require "./engine_query"
require "./mapping"
require "./validation"
require "./request_cache"
require "./middleware"

# The dashboard is fed through CQL's event framework. `Telemetry.subscribe_transactions` and `Schema#pool_stats`
# first shipped in CQL 0.0.541 (0.0.539 and older lack them), so that is the hard floor; `shard.yml` asks for 0.0.925,
# which also provides the per-fiber request tracker required by query_cache: true. Newer
# fields are used when present: `QueryEvent#pool_wait` (0.0.798) and nested transactions as savepoints (0.0.626).
{% unless ::CQL.has_constant?("Telemetry") && ::CQL::Telemetry.class.has_method?("subscribe_transactions") && ::CQL::Schema.has_method?("pool_stats") %}
  {% raise "azu/cql needs CQL 0.0.541 or newer (CQL::Telemetry.subscribe_transactions and CQL::Schema#pool_stats); Azu's shard.yml asks for 0.0.925. Update the cql shard." %}
{% end %}

module Azu
  module CQL
    # Raised by `verify!` when the database cannot be reached.
    class VerificationError < Exception
    end

    # CQL's own configuration (`CQL.configure`), plus the dashboard instrumentation, which is
    # installed right away so `cql.connect` and early queries are captured. Apps that
    # `include Azu` see this module as `CQL`, so `CQL.configure` there resolves to this method.
    def self.configure(& : ::CQL::Configure::Config ->) : ::CQL::Configure::Config
      Instrumentor.install
      ::CQL.configure { |config| yield config }
    end

    def self.config : ::CQL::Configure::Config
      ::CQL.config
    end

    def self.reset_config! : Nil
      ::CQL.reset_config!
    end

    # Defines a schema and wires instrumentation and the playground to it.
    #
    # The URL is, in order: the `uri` argument, `CQL.config.db` once it has been set,
    # `Azu::CONFIG.database.uri` (deprecated, defaults to `DATABASE_URL`). The adapter is picked from
    # the URL scheme. The connection is lazy by default (`database.lazy_connect`, or `lazy:`): the
    # schema is created without opening a socket and the first query connects.
    #
    # `postgres://` and `postgresql://` URLs run on CQL's native `AsyncEngine` pool (its own fiber-safe pool,
    # prepared-statement cache and binary results) when the installed CQL has `CQL::Postgres::EngineSource`.
    # `driver: :db` (or `AZU_CQL_DRIVER=db`) keeps crystal-db's pool and whichever driver it has registered, such as
    # the `pg` shard; `driver: :engine` also opts a `cockroachdb://` URL in. See `Driver`.
    def self.schema(name : Symbol = :app, uri : String? = nil, lazy : Bool? = nil, driver : Symbol? = nil, &) : ::CQL::Schema
      base, from_config = resolve_uri(uri)
      lazy_connect = lazy.nil? ? Azu::CONFIG.database.lazy_connect? : lazy
      Instrumentor.install
      schema = if Driver.resolve(base, driver, Azu::CONFIG.database.driver).engine?
                 engine_schema(name, base, ::CQL.config, lazy_connect, from_config)
               else
                 resolved = connection_url(base, ::CQL.config, lazy_connect, pool: from_config)
                 ::CQL::Schema.new(name, resolved, adapter_for(resolved))
               end
      with schema yield
      attach(schema)
    end

    # Wires instrumentation and the dashboard playground to an existing schema.
    def self.attach(schema : ::CQL::Schema) : ::CQL::Schema
      Instrumentor.install
      track(schema)
      QueryStore.instance.adapter = SchemaAdapter.new(schema)
      schema
    end

    # Same, for a schema that does not exist yet (initializers load before `db/schema.cr`, and the
    # file may be regenerated by CQL's schema dump): the block runs the first time the dashboard
    # needs the schema.
    #
    #   Azu::CQL.attach { AppDB }
    def self.attach(&block : -> ::CQL::Schema) : Nil
      Instrumentor.install
      QueryStore.instance.adapter = SchemaAdapter.new(block)
    end

    @@schemas = {} of Symbol => ::CQL::Schema
    @@schemas_mutex = Mutex.new

    # Registers a schema so `Azu.shutdown` closes its pool. `schema` and `attach` do it for you; call it for a
    # schema made with CQL directly. A schema made earlier under the same name is closed and replaced, so
    # building `:app` twice does not leak the first pool (keep one schema per name).
    def self.track(schema : ::CQL::Schema) : Nil
      replaced = @@schemas_mutex.synchronize do
        previous = @@schemas[schema.name]?
        @@schemas[schema.name] = schema
        previous unless previous.nil? || previous.same?(schema)
      end
      close_quietly(replaced) if replaced
    end

    # Stops tracking a schema (its pool stays open until you close it).
    def self.untrack(schema : ::CQL::Schema) : Nil
      @@schemas_mutex.synchronize { @@schemas.delete(schema.name) if @@schemas[schema.name]?.try(&.same?(schema)) }
    end

    def self.tracked_schemas : Array(::CQL::Schema)
      @@schemas_mutex.synchronize { @@schemas.values }
    end

    # Closes the connection pool of every schema made or attached through this module. `Azu.shutdown` calls
    # it (after PubSub, before Redis; hooks registered later by the app run first); safe to call again. A pool that
    # fails to close is logged, not raised. Requests still running can meet a closed pool.
    def self.shutdown : Nil
      schemas = @@schemas_mutex.synchronize { @@schemas.values.tap { @@schemas.clear } }
      schemas.each { |schema| close_quietly(schema) }
    end

    # Closes a schema's connection pool. A CQL without `Schema#close` has no way to close it from outside: the pool
    # then stays open until the process ends.
    def self.close(schema : ::CQL::Schema) : Nil
      {% if ::CQL::Schema.has_method?("close") %}
        schema.close
      {% end %}
    end

    private def self.close_quietly(schema : ::CQL::Schema) : Nil
      close(schema)
    rescue ex
      ::Log.for("azu.cql").error(exception: ex) { "could not close the pool of schema #{schema.name}" }
    end

    Azu.on_shutdown { Azu::CQL.shutdown }

    # A check for `Azu::Handler::HealthCheck`: `checks: {"database" => Azu::CQL.health_check(AppDB)}`.
    # True when the database answers `SELECT 1` within `timeout`. Meant to say "the database is up", not "the pool
    # has room": on the engine, when every pooled connection is busy it probes over one extra connection that is
    # opened and closed for the check (a full handshake, so do not poll faster than every few seconds) instead of
    # queueing behind the pool. A probe that is still running (a hung database) is not stacked: the next
    # check answers false until it ends, which `checkout_timeout`/`connect_timeout` bound.
    def self.health_check(schema : ::CQL::Schema, timeout : Time::Span = 2.seconds) : Proc(Bool)
      -> { ping(schema, timeout) }
    end

    @@probing = Set(UInt64).new

    def self.ping(schema : ::CQL::Schema, timeout : Time::Span = 2.seconds) : Bool
      id = schema.object_id
      return false unless @@schemas_mutex.synchronize { @@probing.add?(id) }
      answered = ::Channel(Bool).new(1)
      spawn(name: "azu-cql-ping") do
        answered.send(begin
          probe(schema, timeout)
        rescue
          false
        end)
        @@schemas_mutex.synchronize { @@probing.delete(id) }
      end
      select
      when result = answered.receive
        result
      when timeout(timeout)
        false
      end
    end

    {% if ::CQL.has_constant?("ConnectionSource") && ::CQL.has_constant?("Postgres") && ::CQL::Postgres.has_constant?("EngineSource") %}
      # The `AsyncEngine` behind a schema that runs on one (for `pipeline`, `stream`, `with_connection` with
      # LISTEN/NOTIFY or COPY, `transaction(isolation: ...)`); nil for a schema on crystal-db's pool.
      def self.engine(schema : ::CQL::Schema) : ::CQL::Postgres::AsyncEngine?
        schema.source.as?(::CQL::Postgres::EngineSource).try(&.engine)
      end

      private def self.probe(schema : ::CQL::Schema, timeout : Time::Span) : Bool
        engine = engine(schema) || return probe_pooled(schema)
        stats = engine.pool.stats
        return probe_pooled(schema) unless stats.idle == 0 && stats.in_use >= stats.max_size
        connection = ::CQL::Postgres::Connection.open(engine.pool.config)
        begin
          connection.ping(timeout)
        ensure
          connection.close
        end
      end

      private def self.engine_schema(name : Symbol, base : String, config : ::CQL::Configure::Config, lazy : Bool, pool : Bool) : ::CQL::Schema
        url = engine_url(base, config, lazy, pool)
        adapter = adapter_for(base)
        ::CQL::Schema.new(name, url, adapter, source: ::CQL::Postgres::EngineSource.connect(url, adapter))
      end
    {% else %}
      def self.engine(schema : ::CQL::Schema) : Nil
        nil
      end

      private def self.probe(schema : ::CQL::Schema, timeout : Time::Span) : Bool
        probe_pooled(schema)
      end

      private def self.engine_schema(name : Symbol, base : String, config : ::CQL::Configure::Config, lazy : Bool, pool : Bool) : ::CQL::Schema
        raise ArgumentError.new("the CQL engine driver needs a CQL release with CQL::Postgres::EngineSource; update the cql shard or use driver: :db")
      end
    {% end %}

    private def self.probe_pooled(schema : ::CQL::Schema) : Bool
      schema.with_connection(&.scalar("SELECT 1"))
      true
    end

    # The URL for the engine: `base` with crystal-db's pool parameters renamed or removed, plus the engine's
    # pool settings from `config.pool` when `pool` is true (the URL came from CQL's configuration). The engine reads
    # every unknown parameter as a server startup option, so nothing crystal-db owns may stay. Mapping:
    #
    #   max_pool_size (or config.pool.size)      -> pool_size (`max_pool_size=0`, "unlimited" in crystal-db, means the default)
    #   initial_pool_size (eager: config.pool.initial_size) -> pool_min_size (lazy: left at 0), never above pool_size
    #   checkout_timeout (or config.pool.checkout_timeout) -> checkout_timeout (seconds, same name)
    #   prepared_statements=false, prepared_statements_cache=false, config.pool.use_prepared_statements = false
    #                                            -> statement_cache_size=0 (a transaction-mode pooler), unless the URL sets it
    #   max_idle_pool_size, retry_attempts, retry_delay, auth_methods -> dropped
    #
    # Parameters already on the URL win (`pool_size` over `max_pool_size`), and everything the engine understands
    # itself (`sslmode`, `max_queries`, `statement_cache_size`, ...) passes through. The query is edited as text: pairs that
    # are kept stay byte for byte (see `EngineQuery`), and nothing before the `?` is touched.
    def self.engine_url(base : String, config : ::CQL::Configure::Config = ::CQL.config, lazy : Bool = true, pool : Bool = false) : String
      without_fragment, hash, fragment = base.partition('#')
      location, _, query = without_fragment.partition('?')
      edit = EngineQuery.new(query)
      uncached = PREPARED_STATEMENT_PARAMS.any? { |key| edit.value(key).try { |value| OFF_VALUES.includes?(value.downcase) } }
      (PREPARED_STATEMENT_PARAMS + ENGINE_DROPPED_PARAMS).each { |key| edit.delete(key) }
      edit.delete("max_pool_size") unless (edit.value("max_pool_size").try(&.to_i?) || 0) > 0
      edit.rename("max_pool_size", "pool_size")
      edit.rename("initial_pool_size", "pool_min_size")
      edit.add("statement_cache_size", "0") if uncached
      add_engine_defaults(edit, config, lazy, pool)
      clamp_min_size(edit, pool ? config.pool.size : DEFAULT_ENGINE_POOL_SIZE)
      edit.empty? ? "#{location}#{hash}#{fragment}" : "#{location}?#{edit}#{hash}#{fragment}"
    end

    # The engine's own default `pool_size`.
    DEFAULT_ENGINE_POOL_SIZE = 10

    ENGINE_DROPPED_PARAMS     = %w(max_idle_pool_size retry_attempts retry_delay auth_methods)
    PREPARED_STATEMENT_PARAMS = %w(prepared_statements prepared_statements_cache)
    OFF_VALUES                = %w(false 0 off no)

    private def self.add_engine_defaults(edit : EngineQuery, config : ::CQL::Configure::Config, lazy : Bool, pool : Bool) : Nil
      if pool
        edit.add("pool_size", config.pool.size.to_s)
        edit.add("checkout_timeout", config.pool.checkout_timeout.total_seconds.to_s)
        edit.add("statement_cache_size", "0") unless config.pool.use_prepared_statements?
      end
      return if lazy
      size = edit.value("pool_size").try(&.to_i?) || (pool ? config.pool.size : DEFAULT_ENGINE_POOL_SIZE)
      edit.add("pool_min_size", Math.min(pool ? config.pool.initial_size : 1, size).to_s)
    end

    # The engine refuses a minimum above the maximum; crystal-db tolerated it.
    private def self.clamp_min_size(edit : EngineQuery, default_size : Int32) : Nil
      minimum = edit.value("pool_min_size").try(&.to_i?) || return
      size = edit.value("pool_size").try(&.to_i?) || default_size
      edit.replace_value("pool_min_size", size.to_s) if minimum > size
    end

    # Fails fast (for example at boot in production) when the database is unreachable.
    def self.verify!(schema : ::CQL::Schema) : ::CQL::Schema
      schema.with_connection(&.scalar("SELECT 1"))
      schema
    rescue ex
      raise VerificationError.new(<<-MSG)
        Cannot reach the database (#{redact(schema.uri)}): #{ex.message.presence || ex.class.name}
          - Is the server running and reachable?
          - Set the URL with CQL.configure { |c| c.db = ENV["DATABASE_URL"] }.
        MSG
    end

    # Runs the block in a database transaction (rolled back on exception); the
    # queries inside are visible as one transaction in the dashboard.
    def self.transaction(schema : ::CQL::Schema, &)
      schema.transaction { |_tx| yield }
    end

    def self.adapter_for(uri : String) : ::CQL::Adapter
      case scheme = URI.parse(uri).scheme
      when "postgres", "postgresql" then ::CQL::Adapter::Postgres
      when "cockroachdb"            then ::CQL::Adapter::CockroachDB
      when "mysql"                  then ::CQL::Adapter::MySql
      when "sqlite3"                then ::CQL::Adapter::SQLite
      else
        raise ArgumentError.new("Unsupported database URL scheme #{scheme.inspect}; use postgres://, cockroachdb://, mysql:// or sqlite3://")
      end
    end

    # The URL handed to CQL: `base` unchanged, plus the crystal-db pool parameters it does not
    # already set (`initial_pool_size=0` when lazy; the pool size, idle size and checkout
    # timeout of `config.pool`, and for SQLite its `config.sqlite` pragmas (journal_mode, foreign_keys,
    # busy_timeout, ...), when `pool` is true). Parameters already on the URL always win and nothing
    # before the `?` is touched. Deliberately not `config.full_db_url`, which also injects SSL,
    # authentication and retry settings.
    def self.connection_url(base : String, config : ::CQL::Configure::Config = ::CQL.config, lazy : Bool = true, pool : Bool = false) : String
      without_fragment, hash, fragment = base.partition('#')
      location, _, query = without_fragment.partition('?')
      params = HTTP::Params.parse(query)
      wanted = {} of String => String
      if pool
        wanted["max_pool_size"] = config.pool.size.to_s
        wanted["max_idle_pool_size"] = config.pool.max_idle_size.to_s
        wanted["checkout_timeout"] = config.pool.checkout_timeout.total_seconds.to_s
        sqlite_pragmas(base, config).each { |key, value| wanted[key] = value }
      end
      if lazy
        wanted["initial_pool_size"] = "0"
      elsif pool
        wanted["initial_pool_size"] = config.pool.initial_size.to_s
      end
      wanted.reject! { |key, _| params.has_key?(key) }
      return base if wanted.empty?
      wanted.each { |key, value| params[key] = value }
      "#{location}?#{params}#{hash}#{fragment}"
    end

    # CQL's SQLite defaults (WAL, foreign keys on, a busy timeout) as URL parameters. crystal-sqlite3
    # applies them on every pooled connection; without them a bare `sqlite3://` URL runs with foreign
    # keys off and no busy timeout.
    private def self.sqlite_pragmas(url : String, config : ::CQL::Configure::Config) : Hash(String, String)
      params = HTTP::Params.new
      config.sqlite.apply_to_params(params) if url.starts_with?("sqlite3:")
      pragmas = {} of String => String
      params.each { |key, value| pragmas[key] = value }
      pragmas
    end

    # {URL, whether it came from CQL.config}
    private def self.resolve_uri(uri : String?) : {String, Bool}
      return {uri, false} if uri
      configured = ::CQL.config.db
      return {configured, true} unless configured == ::CQL::Configure::Config.new.db
      if fallback = Azu::CONFIG.database.uri.presence
        return {fallback, false}
      end
      raise ArgumentError.new("Azu::CQL.schema needs a database URL: CQL.configure { |c| c.db = ENV[\"DATABASE_URL\"] } (or pass a uri)")
    end

    private def self.redact(url : String) : String
      url.sub(%r{(://[^:/@]*:)[^@]*@}, "\\1***@")
    end

    # Apps usually `include Azu`, which makes this module visible as `CQL` inside
    # their namespace, and CQL's own macros expand unqualified `CQL::...` there.
    # Mirror public ORM types so `CQL::ActiveRecord::Model` keeps resolving.
    # Private implementation types (e.g. CQL v1 MigrationLock) cannot be aliased
    # outside CQL and must not become part of the bridge API.
    {% for name in ::CQL.constants %}
      {% type = ::CQL.constant(name) %}
      {% if type.is_a?(TypeNode) && type.public? && !Azu::CQL.has_constant?(name) %}
        alias {{ name.id }} = ::CQL::{{ name.id }}
      {% end %}
    {% end %}
  end
end
